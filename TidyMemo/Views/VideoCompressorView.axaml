<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:TidyMemo.ViewModels"
             xmlns:models="using:TidyMemo.Models"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:DataType="vm:VideoCompressorViewModel"
             x:Class="TidyMemo.Views.VideoCompressorView">

    <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">

        <Border Grid.Row="0" Classes="warningCard"
                IsVisible="{Binding !IsFfmpegConfigured}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Text="!" FontSize="22" FontWeight="Bold"
                           Foreground="#D97706" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="FFmpeg must be configured before you can process videos"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Settings.FfmpegConfigurationMessage}"
                               TextWrapping="Wrap" Opacity="0.78" />
                    <TextBlock Text="Choose automatic setup, or select ffmpeg / ffmpeg.exe if it is already installed on your computer."
                               TextWrapping="Wrap" Opacity="0.65" FontSize="11" />
                    <ProgressBar Minimum="0" Maximum="100" Height="5" Margin="0 4 0 0"
                                 Value="{Binding Settings.FfmpegDownloadProgress}"
                                 IsVisible="{Binding Settings.IsDownloadingFfmpeg}" />
                    <TextBlock Text="{Binding Settings.FfmpegDownloadStatus}"
                               IsVisible="{Binding !!Settings.FfmpegDownloadStatus}"
                               TextWrapping="Wrap" FontSize="11" Opacity="0.75" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="7" MinWidth="190">
                    <Button Content="{Binding Settings.DetectedPlatform, StringFormat='Download for {0}'}"
                            Classes="accent" HorizontalAlignment="Stretch"
                            Command="{Binding Settings.DownloadFfmpegCommand}" />
                    <Button Content="Select existing FFmpeg..." HorizontalAlignment="Stretch"
                            Command="{Binding Settings.BrowseFfmpegCommand}" />
                    <Button Content="Open video settings" HorizontalAlignment="Stretch"
                            Command="{Binding OpenFfmpegSettingsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Row 0 : Folders + Options ───────────────────────────────── -->
        <Grid Grid.Row="1" ColumnDefinitions="2*,3*" ColumnSpacing="14">

            <!-- Left column : source folders -->
            <Border Grid.Column="0" Classes="videoCard">
            <StackPanel>
                <TextBlock Text="01  SOURCES" Classes="sectionEyebrow" Margin="0 0 0 5" />
                <TextBlock Text="Choose your files" FontWeight="Bold" FontSize="18" />
                <TextBlock TextWrapping="Wrap" Margin="0 3 0 12" Opacity="0.62" FontSize="11"
                           Text="MP4 · MOV · AVI · MKV · WMV · FLV · M4V · WEBM" />
                <ScrollViewer MaxHeight="140" HorizontalScrollBarVisibility="Disabled">
                    <ListBox ItemsSource="{Binding Folders}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               ToolTip.Tip="{Binding FullName}"
                                               TextWrapping="WrapWithOverflow" />
                                    <Button Grid.Column="1"
                                            Command="{Binding $parent[UserControl].((vm:VideoCompressorViewModel)DataContext).RemoveFolderCommand}"
                                            CommandParameter="{Binding}"
                                            VerticalAlignment="Top" HorizontalAlignment="Right">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <Image Width="12" Height="12"
                                                       Source="/Assets/deletebtn.png" />
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0 10 0 0">
                    <Button Grid.Column="0" Content="ADD FILE" Classes="accent"
                            Command="{Binding AddFileCommand}" />
                    <Button Grid.Column="1" Content="ADD FOLDER"
                            Command="{Binding AddFolderCommand}" />
                </Grid>
                <CheckBox Content="Include subfolders"
                          IsChecked="{Binding IncludeSubfolders, Mode=TwoWay}"
                          Margin="0 10 0 0" />
            </StackPanel>
            </Border>

            <!-- Right column : compression options -->
            <Border Grid.Column="1" Classes="videoCard">
            <StackPanel Spacing="8">
                <TextBlock Text="02  PROCESSING" Classes="sectionEyebrow" />
                <TextBlock Text="Configure the output" FontWeight="Bold" FontSize="18" Margin="0 0 0 2" />

                <TextBlock Text="Operation:" FontWeight="SemiBold" />
                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Operations}"
                          SelectedItem="{Binding SelectedOperation, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:VideoProcessingOperationOption">
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.65"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Preset selector -->
                <TextBlock Text="Compression preset:" FontWeight="SemiBold"
                           IsVisible="{Binding IsCompressionMode}" />
                <ComboBox HorizontalAlignment="Stretch"
                          IsVisible="{Binding IsCompressionMode}"
                          ItemsSource="{Binding Presets}"
                          SelectedItem="{Binding SelectedPreset, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:VideoCompressionPreset">
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.65" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Video codec:" FontWeight="SemiBold"
                           IsVisible="{Binding IsCompressionMode}" />
                <ComboBox HorizontalAlignment="Stretch"
                          IsVisible="{Binding IsCompressionMode}"
                          ItemsSource="{Binding VideoCodecs}"
                          SelectedItem="{Binding SelectedVideoCodec, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:VideoCodecOption">
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.65"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <CheckBox Content="Advanced compression settings"
                          IsVisible="{Binding IsCompressionMode}"
                          IsChecked="{Binding UseAdvancedCompressionSettings, Mode=TwoWay}" />
                <Border IsVisible="{Binding IsAdvancedCompressionMode}"
                        Classes="warningCard" Padding="10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Custom FFmpeg settings" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CRF (0–51)" FontSize="11" Opacity="0.7" />
                                <NumericUpDown Minimum="0" Maximum="51" Increment="1"
                                               Value="{Binding CustomCrf, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Encoder preset" FontSize="11" Opacity="0.7" />
                                <ComboBox ItemsSource="{Binding FfmpegPresets}"
                                          SelectedItem="{Binding CustomFfmpegPreset, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="A higher CRF reduces quality and file size. A slower preset improves compression but takes longer."
                                   TextWrapping="Wrap" FontSize="11" Opacity="0.7" />
                    </StackPanel>
                </Border>

                <StackPanel IsVisible="{Binding IsSpeedMode}" Spacing="4">
                    <TextBlock Text="Playback speed factor:" FontWeight="SemiBold" />
                    <NumericUpDown Minimum="1" Maximum="100" Increment="0.1"
                                   FormatString="0.##×"
                                   Value="{Binding SpeedMultiplier, Mode=TwoWay}" />
                    <TextBlock Text="Audio is accelerated with the video when an audio track is available."
                               TextWrapping="Wrap" FontSize="11" Opacity="0.65" />
                </StackPanel>

                <StackPanel IsVisible="{Binding IsConvertMode}" Spacing="4">
                    <TextBlock Text="Output format:" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding OutputFormats}"
                              SelectedItem="{Binding OutputFormat, Mode=TwoWay}" />
                </StackPanel>

                <Border IsVisible="{Binding IsGifMode}" Classes="warningCard" Padding="10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="GIF export constraints" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Maximum width" FontSize="11" Opacity="0.7" />
                                <ComboBox ItemsSource="{Binding GifWidths}"
                                          SelectedItem="{Binding GifWidth, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Frames per second" FontSize="11" Opacity="0.7" />
                                <ComboBox ItemsSource="{Binding GifFrameRates}"
                                          SelectedItem="{Binding GifFps, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="The aspect ratio is preserved, audio is removed, and an optimized 256-color palette is generated. Short clips produce significantly smaller GIF files."
                                   TextWrapping="Wrap" FontSize="11" Opacity="0.7" />
                    </StackPanel>
                </Border>

                <!-- Postfix option -->
                <CheckBox Content="Append a suffix to output filename"
                          IsChecked="{Binding UsePostfix, Mode=TwoWay}"
                          Margin="0 4 0 0" />
                <StackPanel IsVisible="{Binding UsePostfix}"
                            Orientation="Horizontal" Spacing="8" Margin="16 0 0 0">
                    <TextBlock Text="Suffix:" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Postfix, Mode=TwoWay}"
                             MinWidth="70" MaxWidth="120" />
                    <TextBlock VerticalAlignment="Center" Opacity="0.6"
                               Text="(e.g. videoV.mp4)" />
                </StackPanel>
            </StackPanel>
            </Border>
        </Grid>

        <!-- ── Row 1 : Action bar ──────────────────────────────────────── -->
        <Border Grid.Row="2" Classes="videoCard" Padding="14 12">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
            <Button Grid.Column="0" Content="{Binding ActionButtonText}" Classes="accent"
                    FontSize="14" FontWeight="SemiBold"
                    IsEnabled="{Binding CanStart}"
                    Command="{Binding StartCommand}" />
            <Button Grid.Column="1" Content="⬛  CANCEL"
                    FontSize="14" Margin="10 0 0 0"
                    IsEnabled="{Binding IsRunning}"
                    Command="{Binding CancelCommand}" />
            <Button Grid.Column="2" Content="CLEAR"
                    FontSize="14" Margin="10 0 0 0"
                    IsEnabled="{Binding CanClear}"
                    Command="{Binding ClearCommand}" />
            <StackPanel Grid.Column="4" Orientation="Horizontal"
                        VerticalAlignment="Center" Spacing="4"
                        IsVisible="{Binding IsRunning}">
                <TextBlock Text="{Binding ProcessedCount}" />
                <TextBlock Text="/" />
                <TextBlock Text="{Binding TotalCount}" />
                <TextBlock Text="files" />
            </StackPanel>
        </Grid>
        </Border>

        <!-- ── Row 2 : Jobs list ───────────────────────────────────────── -->
        <Border Grid.Row="3" Classes="videoCard" Padding="8">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ListBox Background="Transparent"
                         ItemsSource="{Binding Jobs}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:VideoCompressionJobViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="4 5">

                                <!-- Play button -->
                                <Button Grid.Column="0"
                                        Width="28" Height="28" Padding="0"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                        Margin="0 0 6 0"
                                        Command="{Binding OpenCommand}"
                                        ToolTip.Tip="Open file">▶</Button>

                                <!-- Filename + status (secondary line) -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding InputFilename}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding InputPath}" />
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="11"
                                               Opacity="0.65"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding ErrorMessage}" />
                                </StackPanel>

                                <!-- Settings button — flyout with preset ComboBox -->
                                <Button Grid.Column="2"
                                        Width="28" Height="28" Padding="0"
                                        FontSize="14"
                                        VerticalAlignment="Center"
                                        Margin="4 0 2 0"
                                        IsEnabled="{Binding IsPresetEditable}"
                                        IsVisible="{Binding $parent[UserControl].((vm:VideoCompressorViewModel)DataContext).IsCompressionMode}"
                                        ToolTip.Tip="{Binding SelectedPreset.Name}">⚙
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedRight">
                                            <StackPanel Width="240" Margin="6 4">
                                                <TextBlock Text="Compression preset"
                                                           FontWeight="SemiBold"
                                                           Margin="0 0 0 6" />
                                                <ComboBox HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding Presets}"
                                                          SelectedItem="{Binding SelectedPreset, Mode=TwoWay}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:VideoCompressionPreset">
                                                            <StackPanel Margin="0 2">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Description}"
                                                                           FontSize="10" Opacity="0.65" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <!-- Open generated file location -->
                                <Button Grid.Column="3"
                                        Width="28" Height="28" Padding="0"
                                        VerticalAlignment="Center"
                                        Margin="2 0 0 0"
                                        IsEnabled="{Binding CanOpenOutputFolder}"
                                        ToolTip.Tip="Open output folder"
                                        Command="{Binding OpenOutputFolderCommand}">📂</Button>

                                <!-- Remove job button -->
                                <Button Grid.Column="4"
                                        Width="28" Height="28" Padding="0"
                                        VerticalAlignment="Center"
                                        Margin="2 0 0 0"
                                        IsEnabled="{Binding IsPresetEditable}"
                                        ToolTip.Tip="Remove from list"
                                        Command="{Binding $parent[UserControl].((vm:VideoCompressorViewModel)DataContext).RemoveJobCommand}"
                                        CommandParameter="{Binding}">
                                    <Image Width="12" Height="12" Source="/Assets/deletebtn.png" />
                                </Button>

                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Border>

        <!-- ── Row 3 : Status bar ──────────────────────────────────────── -->
        <TextBlock Grid.Row="4" Margin="4 0 0 0"
                   Text="{Binding StatusMessage}"
                   TextTrimming="CharacterEllipsis"
                   Opacity="0.75" />
    </Grid>
</UserControl>
